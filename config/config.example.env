# Trakt API Credentials
# Get these from: https://trakt.tv/oauth/applications
# Run scripts/fresh_auth.py once to get tokens; refresh_token enables auto-refresh when access_token expires.
TRAKT_CLIENT_ID=your_client_id_here
TRAKT_CLIENT_SECRET=your_client_secret_here
TRAKT_ACCESS_TOKEN=your_access_token_here
TRAKT_REFRESH_TOKEN=your_refresh_token_here

# RSS feeds for MOVIE sync only (Film category – do not use Sorozat/series URLs here)
# Prefer RSS_FEED_MOVIES_X; RSS_FEED_1 / RSS_URL are fallbacks.
RSS_FEED_MOVIES_1=http://finderss.it.cx/?&s=2025.720p&cat=Film%20(HUN%20HD),
RSS_FEED_MOVIES_2=http://finderss.it.cx/?&s=2026.720p&cat=Film%20(HUN%20HD),

# Trakt List Configuration
TRAKT_LIST_SLUG=your-list-slug
TRAKT_SERIES_LIST_SLUG=legujabb-sorozatok-ncore
TRAKT_USERNAME=your_username

# nCore credentials – for build_most_seeded_movies_catalog.py (Legnagyobb seed filmek + genre catalogs)
# Add these to config/config.env only; config.env is in .gitignore and is never committed.
NCORE_USER=your_ncore_username
NCORE_PASS=your_ncore_password

# GitHub Actions cron: workflow runs sync scripts every 3h. Add the same vars as repo Secrets
# (Settings → Secrets and variables → Actions). See README "Scheduled sync" for the full list.

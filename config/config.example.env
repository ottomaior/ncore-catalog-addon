# TMDB API Key (movies + Hungarian filter)
# Get this from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# TVDB API Key (series catalogs only)
# Get this from: https://thetvdb.com/dashboard (API Keys)
# If you have a user-supported key, also set TVDB_PIN (subscriber PIN).
TVDB_API_KEY=your_tvdb_api_key_here
# TVDB_PIN=your_pin_if_required

# nCore credentials – for catalog build scripts
# Add these to config/config.env only; config.env is in .gitignore and is never committed.
NCORE_USER=your_ncore_username
NCORE_PASS=your_ncore_password

# Optional: Subtitle uploads persistence (Railway)
# When using a Railway Volume, mount it at /data and set this so uploads survive redeploys:
# SUBTITLES_DATA_DIR=/data/subtitles

# Optional: Catalog build configuration
# Big catalog size: Legfrissebb (build_latest) target; streaming catalogs are split from this via split_catalogs_by_provider.py
# NCORE_CATALOG_TARGET_LATEST=2000
# NCORE_INCREMENTAL_TORRENT_COUNT=100
# Top-seeded targets
# NCORE_CATALOG_TARGET_MOVIES=4000
# NCORE_CATALOG_TARGET_SERIES=2000
# NCORE_PAGES_PER_RUN=15
# NCORE_PAGE_DELAY=3.0
# NCORE_PAGE_RETRIES=4
# NCORE_RETRY_WAIT=35.0

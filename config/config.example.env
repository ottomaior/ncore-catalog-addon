# TMDB API Key
# Get this from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# nCore credentials – for catalog build scripts
# Add these to config/config.env only; config.env is in .gitignore and is never committed.
NCORE_USER=your_ncore_username
NCORE_PASS=your_ncore_password

# Optional: Catalog build configuration
# NCORE_CATALOG_TARGET_MOVIES=4000
# NCORE_CATALOG_TARGET_SERIES=2000
# NCORE_PAGES_PER_RUN=15
# NCORE_PAGE_DELAY=3.0
# NCORE_PAGE_RETRIES=4
# NCORE_RETRY_WAIT=35.0

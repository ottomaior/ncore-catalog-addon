# Trakt API Credentials
# Get these from: https://trakt.tv/oauth/applications
# Run scripts/fresh_auth.py once to get tokens; refresh_token enables auto-refresh when access_token expires.
TRAKT_CLIENT_ID=your_client_id_here
TRAKT_CLIENT_SECRET=your_client_secret_here
TRAKT_ACCESS_TOKEN=your_access_token_here
TRAKT_REFRESH_TOKEN=your_refresh_token_here

# RSS Feed URLs (add more with RSS_FEED_3, RSS_FEED_4, etc.)
RSS_FEED_1=http://finderss.it.cx/?&s=2025.720p&cat=Film%20(HUN%20HD),
RSS_FEED_2=http://finderss.it.cx/?&s=2026.720p&cat=Film%20(HUN%20HD),

# Trakt List Configuration
TRAKT_LIST_SLUG=your-list-slug
TRAKT_SERIES_LIST_SLUG=legujabb-sorozatok-ncore
TRAKT_USERNAME=your_username
